# Optional authorized research inference endpoint.
# HTTPS is required except for http://localhost or http://127.0.0.1 development.
VITE_FACIAL_PARALYSIS_API_URL=

# Explicit interface-preview control. Keep false unless demonstration access is intended.
# Demonstration output is never model output and is never used as automatic fallback.
VITE_ENABLE_DEMONSTRATION=false

# Fail-closed contract pins are compiled into src/model/inference.ts and are not
# runtime overrides:
# model_file: warmstart_v4_expanded.pt
# model_sha256: 6310052121ed8a9a9e746716cb9c0d178eb252b438b6de7d33160eb555f6417b
# preprocessing_version: predict-pipeline/v1
# segmentation_version: faces-segmentation/v1
# request schema: faces-capture-manifest/v1
# response schema: facial-palsy-research-inference/v1
