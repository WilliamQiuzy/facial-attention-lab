# ============================================================
# SECRETS — never commit
# ============================================================
.env
**/.env
*.pem
*.key
*credentials*

# ============================================================
# Mayo PATIENT DATA — never commit (PHI / IRB)
# ============================================================
facial_paralysis/data/livelinkface_data/
# Direction #4 depth3d: patient biometrics (RGB faces, depth maps, landmark coords).
# Keep only derived asymmetry numbers + de-identified figure.
facial_paralysis/outputs/depth3d/*_rgb.jpg
facial_paralysis/outputs/depth3d/*_depth.npy
facial_paralysis/outputs/depth3d/landmarks.json
facial_paralysis/outputs/depth3d/harvest/

# ============================================================
# Large datasets, raw media, derived caches
# ============================================================
facial_paralysis/data/external/
facial_paralysis/data/mediapipe_out/
facial_paralysis/papers/
**/*.mov
**/*.mp4
**/*.avi
**/*.bin
**/*.7z
**/*.zip
facial_paralysis/outputs/*_bundles/
facial_paralysis/outputs/mayo_bundles/
facial_paralysis/outputs/mayo_bundles_norm/
facial_paralysis/outputs/expanded_bundles/
facial_paralysis/outputs/mayo_blendshapes/
facial_paralysis/outputs/mayo_segments/
facial_paralysis/outputs/cfd_bundles/
