facial_paralysis/outputs/fp_cache.pt
# old demo media in viz (may contain non-schematic frames) — keep only the made figures
facial_paralysis/outputs/viz/*demo*
facial_paralysis/outputs/viz/*_v2.png

# ============================================================
# Baseline reproductions: heavy weights + nested git repos
# ============================================================
facial_paralysis/src/baselines/
**/*.pth
**/*.pack

# Report backups (keep the main .docx)
**/*.docx.bak*

